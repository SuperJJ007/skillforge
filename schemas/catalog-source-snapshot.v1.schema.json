{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.local/schemas/catalog-source-snapshot.v1.schema.json",
  "title": "SkillForge catalog source snapshot v1",
  "description": "爬虫或人工采集器产出的只读来源快照。它记录项目自述事实，不拥有目录标题、中文简介、分类或发布状态。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceSlug",
    "sourceType",
    "source",
    "project"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resourceSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sourceType": { "const": "official-repository" },
    "source": { "$ref": "#/$defs/source" },
    "project": { "$ref": "#/$defs/project" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "canonicalUrl",
        "revision",
        "revisionUrl",
        "revisionCommittedAt",
        "fetchedAt",
        "parserVersion"
      ],
      "properties": {
        "provider": { "const": "github" },
        "canonicalUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revisionUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/commit/[0-9a-f]{40}$"
        },
        "revisionCommittedAt": { "type": "string", "format": "date-time" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "parserVersion": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "evidenceUrl"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidenceUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/blob/[0-9a-f]{40}/"
        }
      }
    },
    "installationMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "command", "evidenceUrl"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "evidenceUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/blob/[0-9a-f]{40}/"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "name", "evidenceUrl"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "evidenceUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/blob/[0-9a-f]{40}/"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredVersion",
        "homepageUrl",
        "ownerUrl",
        "ownerAvatarUrl",
        "license",
        "capabilities",
        "installationMethods",
        "requirements",
        "integrations",
        "cautions"
      ],
      "properties": {
        "declaredVersion": {
          "type": ["string", "null"]
        },
        "homepageUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "ownerUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "ownerAvatarUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "license": { "$ref": "#/$defs/license" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "installationMethods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/installationMethod" }
        },
        "requirements": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "integrations": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "cautions": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceItem" }
        }
      }
    }
  }
}
